# Supabase Configuration
# Leave empty to run in MOCK MODE (local state only, no database)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For testing with a local/test Supabase project:
# 1. Create a new Supabase project at https://supabase.com
# 2. Run the migrations in supabase/migrations/ folder
# 3. Copy your project URL and anon key here
# 4. Create a .env.local file with your actual values
