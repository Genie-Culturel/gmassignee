# Supabase Configuration (Lovable project dnxyidnkmtrmkxucqrry)
# Leave empty to run in MOCK MODE (local state only, no database)
#
# The app now connects to the Lovable Supabase project (shared with GMassignee planning).
# All GMassignee tables have a gh_ prefix (gh_vr_sessions, gh_procedure_fiches, etc.).
# Auth uses Supabase Auth + user_roles table (role 'admin', 'gm', etc.).
#
# Required in production (GitHub Pages workflow secrets/vars):
VITE_SUPABASE_URL=https://dnxyidnkmtrmkxucqrry.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy var (use VITE_SUPABASE_PUBLISHABLE_KEY instead):
# VITE_SUPABASE_ANON_KEY=

# Public app URL for client souvenir links (defaults to GitHub Pages)
# VITE_PUBLIC_APP_URL=https://genie-culturel.github.io/gmassignee
